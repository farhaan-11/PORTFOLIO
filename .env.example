# Ye file sirf dikhane ke liye hai ki kaun si keys chahiye.
# Asli value .env.local mein jaati hai, jo kabhi git pe push nahi hoti.

# Ask panel ke live jawab ke liye. Isko khaali chhod do to panel band nahi hota —
# woh pehle se likhe jawab dikhata hai (src/content/ask.ts), aur label mein
# saaf likhta hai ki jawab pre-written hai.
OPENAI_API_KEY=

# Optional. Khaali chhodo to "gpt-4.1-mini" chalta hai. Panel ka kaam sochna
# nahi, bahut saare niyam ek saath nibhana hai (third person, banned words,
# non-technical bhasha) — aur usi mein chhote model phisalte hain.
# Kisi account pe ye model na chale to yahan gpt-4o-mini likh dena.
ASK_MODEL=

# Contact form ka mail Resend ke through jata hai (src/app/api/contact/route.ts).
# Key na ho to form "address pe likh do" wali line dikhata hai — jhootha
# "sent" kabhi nahi dikhata. Key resend.com pe free account se milti hai.
RESEND_API_KEY=

# Optional. Khaali chhodo to mail profile.ts wale address pe jata hai.
CONTACT_TO_EMAIL=

# Optional. Khaali chhodo to Resend ke test address se mail aata hai
# (onboarding@resend.dev). Apna domain Resend pe verify ho jaye to yahan
# "Farhan Ansari <hello@tumhara-domain.com>" likh dena.
CONTACT_FROM_EMAIL=
